# linklist 配置文件
# 优先级：环境变量 > 本文件 > 默认值
# 完整字段与说明见 README.md 配置表。

listen = "0.0.0.0:9090"
data_dir = "./data"
log = "info"

# 数据库连接串（环境变量 LINKLIST_DATABASE_URL，兼容通用别名 DATABASE_URL，前者优先）
# 留空/省略 = 使用 data_dir 下的 SQLite（linklist.db，默认）；
# 三种后端按连接串前缀自动选择：
#   SQLite:     sqlite://data/linklist.db?mode=rwc
#   PostgreSQL: postgres://user:pass@host:5432/dbname
#   MySQL:      mysql://user:pass@host:3306/dbname?characterEncoding=utf8mb4
# database_url = ""

session_ttl_secs = 604800
token_ttl_days = 0
guest_sharing = false

login_max_failures = 10
login_window_secs = 300

fetch_timeout_secs = 30
fetch_max_bytes = 5242880
fetch_max_redirects = 5
allowed_internal_hosts = []
